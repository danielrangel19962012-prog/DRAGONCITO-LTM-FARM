-- Lógica de Funciones
local function setGravity(val)
	val = math.clamp(val, 0, 1000)
	Workspace.Gravity = val
	gravityLabel.Text = "Gravedad Actual: " .. math.floor(val)
end

-- Función para crear una pared invisible
local function createWall(name, size, cframe)
	local wall = Instance.new("Part")
	wall.Name = name
	wall.Size = size
	wall.CFrame = cframe
	wall.Transparency = 1 -- Totalmente invisible
	wall.Anchored = true
	wall.CanCollide = true
	wall.Parent = boundsFolder
	return wall
end

local function toggleTrampolineBounds()
	boundsEnabled = not boundsEnabled
	
	if boundsEnabled then
		btnBounds.Text = "Jaula Trampolín: ACTIVADO"
		btnBounds.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
		
		local char = player.Character or player.CharacterAdded:Wait()
		local root = char:FindFirstChild("HumanoidRootPart")
		
		if root then
			boundsFolder = Instance.new("Folder")
			boundsFolder.Name = "DragoncitoLTM_Bounds"
			boundsFolder.Parent = Workspace
			
			local pos = root.Position
			-- Ajuste preciso para el tamaño del trampolín de la foto:
			local size = 12  -- Ajustado justo al borde del trampolín
			local height = 150 -- Altura máxima del rebote
			
			-- Techo
			createWall("Ceiling", Vector3.new(size, 2, size), CFrame.new(pos + Vector3.new(0, height, 0)))
			-- Paredes laterales ajustadas
			createWall("WallNorth", Vector3.new(size, height, 1), CFrame.new(pos + Vector3.new(0, height/2, size/2)))
			createWall("WallSouth", Vector3.new(size, height, 1), CFrame.new(pos + Vector3.new(0, height/2, -size/2)))
			createWall("WallEast", Vector3.new(1, height, size), CFrame.new(pos + Vector3.new(size/2, height/2, 0)))
			createWall("WallWest", Vector3.new(1, height, size), CFrame.new(pos + Vector3.new(-size/2, height/2, 0)))
		end
	else
		btnBounds.Text = "Jaula Trampolín: DESACTIVADO"
		btnBounds.BackgroundColor3 = Color3.fromRGB(100, 50, 50)
		if boundsFolder then
			boundsFolder:Destroy()
			boundsFolder = nil
		end
	end
end

-- Eventos
minimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		contentFrame.Visible = false
		mainFrame.Size = UDim2.new(0, 260, 0, 35)
		minimizeBtn.Text = "+"
	else
		contentFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 260, 0, 220)
		minimizeBtn.Text = "-"
	end
end)

btnBajar.MouseButton1Click:Connect(function()
	setGravity(Workspace.Gravity - 50)
end)

btnSubir.MouseButton1Click:Connect(function()
	setGravity(Workspace.Gravity + 50)
end)

btnReset.MouseButton1Click:Connect(function()
	setGravity(196.2)
end)

btnBounds.MouseButton1Click:Connect(toggleTrampolineBounds)
